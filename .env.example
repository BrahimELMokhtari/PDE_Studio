# ============================================================================
# PDE Simulation Studio — Environment Configuration Template (Phase 3)
# ============================================================================

# --- Application & CORS ---
APP_NAME="PDE Simulation Studio API"
# Set to "production" in cloud deployments (enforces fail-closed OIDC authentication)
APP_ENV="development"
API_HOST="0.0.0.0"
API_PORT="8000"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173"

# --- Database Persistence ---
# Leave DATABASE_URL empty in local dev to use SQLite; set to PostgreSQL DSN in production:
# DATABASE_URL="postgresql://user:password@hostname:5432/pde_simulation_studio"
DATABASE_URL=""
SQLITE_DB_PATH="./data/pde_studio.db"

# --- Durable Object Storage (Meshes, Scripts, VTU, CSV, ZIP Packages) ---
# "local" for local development; "s3" for AWS S3 / Cloudflare R2 / MinIO / DigitalOcean Spaces
STORAGE_BACKEND="local"
LOCAL_STORAGE_PATH="./data/artifacts"
S3_ENDPOINT_URL=""
S3_BUCKET_NAME="pde-simulation-studio"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="us-east-1"

# --- Redis + RQ Numerical Worker Queue ---
REDIS_URL="redis://localhost:6379/0"
RQ_QUEUE_NAME="pde_simulations"
JOB_TIMEOUT_SECONDS="180"
MAX_MESH_ELEMENTS="250000"
MAX_INLINE_SURFACE_TRIANGLES="15000"

# --- OIDC Authentication & Authorization (Fails Closed in Production) ---
AUTH_REQUIRED="false"
OIDC_ISSUER_URL=""
OIDC_AUDIENCE="pde-simulation-studio-api"
OIDC_JWKS_URL=""
OIDC_JWT_SECRET=""
OIDC_ALGORITHMS="RS256,HS256"

# --- Rate Limits, Upload Size & Per-User Quotas ---
RATE_LIMIT_PER_MINUTE="120"
MAX_REQUEST_BODY_BYTES="2097152"
MAX_PROJECTS_PER_USER="50"
MAX_SIMULATION_JOBS_PER_USER="100"
MAX_STORAGE_BYTES_PER_USER="524288000"

# --- Frontend ---
VITE_API_BASE_URL="http://localhost:8000"
